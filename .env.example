# Ren works in deterministic demo mode without these values.
# Add a compatible vision endpoint to enable general screen understanding.
OPENAI_API_KEY=
REN_API_BASE=https://api.openai.com/v1
REN_MODEL=

# Optional desktop connection to a Ren-hosted image service for staging.
# A Ren access token is separate from the OpenAI provider key held by the server.
REN_IMAGE_SERVICE_URL=
REN_IMAGE_ACCESS_TOKEN=

