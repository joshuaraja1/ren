{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "tsBuildInfoFile": "dist-electron/.tsbuildinfo",
    "types": ["node"],
    "composite": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts"],
  "exclude": ["electron/**/*.test.ts"]
}

