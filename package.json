{
  "name": "ren",
  "version": "0.1.0",
  "private": true,
  "description": "A screen-aware learning companion",
  "author": {
    "name": "Ren contributors",
    "email": "joshuaraja1@users.noreply.github.com"
  },
  "desktopName": "Ren.desktop",
  "license": "MIT",
  "repository": "https://github.com/joshuaraja1/ren",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist:staging": "npm run build && electron-builder --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx-node": "^2.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^27.2.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "ai.ren.teacher",
    "productName": "Ren",
    "asar": true,
    "asarUnpack": ["node_modules/sherpa-onnx-*/**/*"],
    "extraResources": [{ "from": "models/ren-kws", "to": "ren-kws" }],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-*/**/*",
      "package.json"
    ],
    "artifactName": "Ren-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ren listens locally for Hey Ren and captures your question only when invited."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Education",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
