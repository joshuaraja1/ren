{
  "name": "ren",
  "version": "0.1.0",
  "private": true,
  "description": "A screen-aware learning companion",
  "author": {
    "name": "Ren contributors",
    "email": "joshuaraja1@users.noreply.github.com"
  },
  "desktopName": "Ren.desktop",
  "license": "MIT",
  "repository": "https://github.com/joshuaraja1/ren",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:electron && npm run build:server && npm run verify:assets",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start:image-service": "node dist-server/server/index.js",
    "create:image-access-token": "node scripts/create-image-access-token.mjs",
    "verify:assets": "node scripts/check-built-assets.mjs",
    "typecheck": "tsc -b tsconfig.electron.json && tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist:staging": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "koffi": "3.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx-node": "^2.0.3",
    "three": "^0.187.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^27.2.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "ai.ren.teacher",
    "productName": "Ren",
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-*/**/*",
      "node_modules/sherpa-onnx-*/**/*",
      "node_modules/uiohook-napi/prebuilds/**/*"
    ],
    "extraResources": [
      {
        "from": "models/ren-kws",
        "to": "ren-kws"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-*/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-*/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*",
      "package.json",
      "node_modules/ws/**/*"
    ],
    "artifactName": "Ren-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ren detects Hey Ren on device, then sends spoken questions to Deepgram for transcription.",
        "NSScreenCaptureUsageDescription": "Ren captures the screen only when you ask a question so it can explain what you are viewing."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Education",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
